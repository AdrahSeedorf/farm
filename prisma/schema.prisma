// ADRAH Farms — Platform schema
// Milestone 0: structural core only. Production modules (health, feed, orders,
// workforce) arrive in their own milestones and build on these foundations.
//
// THREE RULES GOVERN THIS SCHEMA. See README "Architectural rules".
//   1. Population and stock are DERIVED from append-only event ledgers.
//      There is no writable `population` or `quantityOnHand` column anywhere.
//   2. Money is stored as INTEGER PESEWAS (GHS x 100). Never a float.
//   3. Quantities are stored in a BASE UNIT with an explicit UnitOfMeasure.
//
// Nothing in the core is named Flock / Chicken / House / Egg. Those are
// presentation terms resolved from SpeciesProfile.terminology.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and is
// supplied to PrismaClient through a driver adapter at runtime. See src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ORGANISATION & PHYSICAL STRUCTURE
// Organisation -> Site -> ProductionUnit
// ---------------------------------------------------------------------------

model Organisation {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  /// ISO 4217. Ghana Cedi by default; the money layer refuses mixed currencies.
  currency  String   @default("GHS")
  /// IANA timezone. Ghana has no DST.
  timezone  String   @default("Africa/Accra")

  /// How many days a stock order takes to arrive, from placing it to receiving
  /// it. Drives every "days of cover" judgement: four days of feed is
  /// comfortable with a next-day supplier and an emergency with a fortnightly
  /// one, so a fixed threshold would cry wolf on one farm and stay silent on
  /// another. See src/lib/stock-cover.ts.
  stockLeadTimeDays Int @default(7)

  /// What a ready-to-lay pullet costs to BUY, as last quoted to this farm.
  ///
  /// NULLABLE, AND NOTHING FILLS IT IN AUTOMATICALLY. It is the figure the whole
  /// rear-or-buy decision turns on, it moves with the season and the supplier,
  /// and a default baked into software would be a stale number wearing the
  /// clothes of a fact. The comparison is simply not shown until someone enters
  /// a real quote.
  ///
  /// Dated, so the screen can say how old the quote is instead of presenting a
  /// figure from last year as though it were today's.
  pulletMarketPricePesewas Int?
  pulletMarketPriceOn      DateTime? @db.Date
  pulletMarketPriceSource  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites           Site[]
  users           User[]
  speciesProfiles SpeciesProfile[]
  items           Item[]
  auditLogs       AuditLog[]
  healthProgrammes HealthProgramme[]
  breeds          Breed[]
  costAllocations CostAllocation[]
  biosecurityChecklists BiosecurityChecklist[]
  suppliers       Supplier[]
  purchaseOrders  PurchaseOrder[]
  attendance      AttendanceEvent[]
  tasks           Task[]
}

model Site {
  id             String  @id @default(cuid())
  organisationId String
  name           String
  code           String
  region         String?
  district       String?
  town           String?
  latitude       Float?
  longitude      Float?
  isActive       Boolean @default(true)

  /// Hours a visitor should be clear of other poultry before entering here.
  ///
  /// NULLABLE, WITH NO DEFAULT SHIPPED. How long a farm asks for is a judgement
  /// about local disease pressure, the season and who is visiting, and it
  /// belongs to the farm and its veterinarian — not to software written in
  /// advance of knowing any of that. Until it is set, the visitor log records
  /// the declared elapsed time and passes no verdict at all.
  ///
  /// ON THE SITE, not the organisation, because it is a property of a PLACE.
  /// A farm beside a live-bird market and one at the end of a track do not face
  /// the same pressure, and the day this business runs two sites the shared
  /// figure would be wrong for at least one of them.
  visitorDowntimeHours Int?

  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  productionUnits ProductionUnit[]
  animalGroups    AnimalGroup[]
  stockLocations  StockLocation[]
  userSiteScopes  UserSiteScope[]
  visitorLogs     VisitorLog[]
  cleaningRecords CleaningRecord[]
  biosecurityChecks BiosecurityCheck[]
  purchaseOrders    PurchaseOrder[]
  attendance        AttendanceEvent[]
  tasks             Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, code])
  @@index([organisationId])
}

/// A house, pen, pond or paddock. Deliberately not named "House".
model ProductionUnit {
  id       String  @id @default(cuid())
  siteId   String
  name     String
  code     String
  /// Nominal bird/animal capacity. Advisory only — never used to cap events.
  capacity Int?
  notes    String?
  isActive Boolean @default(true)

  /// How often this place should be cleaned, in days.
  ///
  /// NULLABLE, WITH NO DEFAULT. A house between flocks, a house with birds in
  /// it, and a store room are cleaned on completely different rhythms, and the
  /// right number depends on the farm's own routine. Until one is set the
  /// cleaning log still records everything; it simply calls nothing overdue.
  /// See cleaningStatus() in src/lib/biosecurity.ts — a place with no interval
  /// reads as UNTRACKED, never as up to date.
  cleaningIntervalDays Int?

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  animalGroups AnimalGroup[]
  dailyRecords DailyRecord[]
  productionRecords ProductionRecord[]
  cleaningRecords   CleaningRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, code])
  @@index([siteId])
}

// ---------------------------------------------------------------------------
// SPECIES FRAMEWORK
// Adding pigs/cattle/fish later is new ROWS here, not a schema migration.
// ---------------------------------------------------------------------------

model SpeciesProfile {
  id             String @id @default(cuid())
  organisationId String
  /// Stable key used in code: "poultry", "swine", "cattle", "fish".
  key            String
  name           String
  /// UI terminology map, e.g.
  /// { "animalGroup": "Flock", "productionUnit": "House", "animal": "Bird" }
  terminology    Json
  isActive       Boolean @default(true)

  organisation    Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  productionTypes ProductionTypeProfile[]
  animalGroups    AnimalGroup[]
  healthProgrammes HealthProgramme[]
  breeds          Breed[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, key])
}

/// e.g. poultry -> "layer", "broiler", "breeder". Carries the metric set and
/// target curves. Targets are CONFIGURATION, never hard-coded in application logic.
model ProductionTypeProfile {
  id               String @id @default(cuid())
  speciesProfileId String
  key              String
  name             String
  /// Which record types apply, e.g.
  /// { "eggProduction": true, "weightSampling": true, "milkYield": false }
  capabilities     Json
  /// Breed standard curves and thresholds, e.g.
  /// { "breed": "Isa Brown", "targetBodyWeightByAgeDays": {...},
  ///   "targetHenDayByAgeWeeks": {...}, "mortalityAlertPctDaily": 0.5 }
  standards        Json?

  speciesProfile SpeciesProfile   @relation(fields: [speciesProfileId], references: [id], onDelete: Cascade)
  lifecycleStages LifecycleStage[]
  animalGroups   AnimalGroup[]
  healthProgrammes HealthProgramme[]
  breeds         Breed[]
  productionGrades ProductionGrade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([speciesProfileId, key])
}

/// Configurable lifecycle: Brooding -> Growing -> Pre-lay -> Laying -> ...
/// Drives which fields the daily record screen shows at a given flock age.
model LifecycleStage {
  id                      String @id @default(cuid())
  productionTypeProfileId String
  key                     String
  name                    String
  /// Ordering within the lifecycle.
  sequence                Int
  /// Advisory age window in days; used to prompt, never to force a transition.
  typicalStartAgeDays     Int?
  typicalEndAgeDays       Int?

  /// The stage at which this group STOPS being an investment and STARTS being
  /// an asset that earns — first egg for a layer, first milking for a dairy
  /// herd, first harvest for a pond.
  ///
  /// A FLAG ON THE PROFILE RATHER THAN A KEY IN THE CODE. Reading
  /// `key === 'laying'` in the costing layer would put a poultry word in the
  /// core, and the day this platform carries a second species that word would
  /// be wrong. Which stage it is belongs to the production type, which is data.
  ///
  /// Some production types have no such stage at all — a broiler is sold, never
  /// switched over — and then the cost-per-point-of-lay figure simply does not
  /// apply and is not shown.
  isProductionStart       Boolean @default(false)

  productionType ProductionTypeProfile @relation(fields: [productionTypeProfileId], references: [id], onDelete: Cascade)
  animalGroups   AnimalGroup[]
  events         AnimalGroupEvent[]

  @@unique([productionTypeProfileId, key])
  @@index([productionTypeProfileId, sequence])
}

// ---------------------------------------------------------------------------
// ANIMAL GROUPS  (flock / herd / batch / shoal)
// ---------------------------------------------------------------------------

model AnimalGroup {
  id                      String  @id @default(cuid())
  siteId                  String
  productionUnitId        String?
  speciesProfileId        String
  productionTypeProfileId String

  /// Human reference, e.g. "FLK-2027-01".
  code                    String
  name                    String?
  /// Chosen from the breed catalogue rather than typed. A typed breed cannot be
  /// matched to a growth curve, and "Isa brown" / "ISA Brown" / "isa" would be
  /// three different breeds as far as any later report was concerned.
  breedId                 String?
  supplierName            String?

  /// Date of hatch/birth — the basis for ALL age calculations. Not arrival date:
  /// a flock delivered late is still the age it hatched.
  dateOfHatch             DateTime  @db.Date
  arrivalDate             DateTime? @db.Date

  /// Denormalised CACHE of the latest STAGE_CHANGE event. The event ledger is
  /// the source of truth; this column exists to keep list queries cheap and is
  /// rebuildable with `npm run rebuild:derived`.
  currentStageId          String?

  /// The health programme this flock follows, if any. Nullable on purpose: a
  /// flock placed before the vet has supplied a programme must still be
  /// recordable, and the schedule simply says there is nothing scheduled.
  healthProgrammeId       String?

  closedAt                DateTime?
  notes                   String?

  site           Site                  @relation(fields: [siteId], references: [id])
  productionUnit ProductionUnit?       @relation(fields: [productionUnitId], references: [id])
  speciesProfile SpeciesProfile        @relation(fields: [speciesProfileId], references: [id])
  productionType ProductionTypeProfile @relation(fields: [productionTypeProfileId], references: [id])
  currentStage   LifecycleStage?       @relation(fields: [currentStageId], references: [id])
  healthProgramme HealthProgramme?     @relation(fields: [healthProgrammeId], references: [id])
  breedRef       Breed?                @relation(fields: [breedId], references: [id])

  events        AnimalGroupEvent[]
  snapshots     AnimalGroupSnapshot[]
  weightSamples WeightSample[]
  costEntries   FlockCostEntry[]
  dailyRecords  DailyRecord[]
  healthEvents  HealthEvent[]
  productionRecords ProductionRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, code])
  @@index([siteId, closedAt])
  @@index([productionUnitId])
}

enum AnimalGroupEventType {
  PLACEMENT
  MORTALITY
  CULL
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  STAGE_CHANGE
}

/// THE POPULATION LEDGER. Append-only. Never updated, never deleted.
/// A correction is a new ADJUSTMENT row with a reason — not an edit to history.
model AnimalGroupEvent {
  id            String               @id @default(cuid())
  animalGroupId String
  type          AnimalGroupEventType

  /// SIGNED change in population. Deaths are negative, placements positive.
  /// Set exclusively by `recordAnimalGroupEvent()` from (type, quantity) so the
  /// sign can never disagree with the event type. STAGE_CHANGE carries delta 0.
  delta         Int

  occurredOn    DateTime @db.Date
  /// Denormalised age in days at the time of the event, for fast cohort queries.
  ageDays       Int?

  /// Controlled vocabulary, e.g. "disease", "heat_stress", "predation",
  /// "recount_correction". Enables cause analysis without free-text mining.
  reasonCode    String?
  notes         String?

  /// Where this event came from — a daily record, a sale, a manual correction.
  sourceType    String?
  sourceId      String?

  /// Set only on STAGE_CHANGE events.
  toStageId     String?

  recordedById  String
  createdAt     DateTime @default(now())

  animalGroup AnimalGroup     @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)
  recordedBy  User            @relation(fields: [recordedById], references: [id])
  toStage     LifecycleStage? @relation(fields: [toStageId], references: [id])

  @@index([animalGroupId, occurredOn])
  @@index([animalGroupId, type])
}

/// Nightly materialised view of population and age. A CACHE ONLY.
/// Safe to truncate and rebuild from AnimalGroupEvent at any time.
model AnimalGroupSnapshot {
  id            String   @id @default(cuid())
  animalGroupId String
  onDate        DateTime @db.Date
  openingCount  Int
  closingCount  Int
  ageDays       Int
  computedAt    DateTime @default(now())

  animalGroup AnimalGroup @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)

  @@unique([animalGroupId, onDate])
  @@index([onDate])
}

/// Body weight and uniformity. Core for layer rearing: uniformity at 16 weeks
/// is the best available predictor of the laying cycle, and cannot be fixed later.
model WeightSample {
  id            String   @id @default(cuid())
  animalGroupId String
  takenOn       DateTime @db.Date
  ageDays       Int
  sampleSize    Int
  /// Individual weights in GRAMS. Average and CV% are computed from these
  /// (see src/lib/metrics.ts) rather than stored, so they can never drift.
  weightsGrams  Int[]
  /// Optional pre-aggregated average for imported or hand-tallied data where
  /// individual weights were not captured.
  averageGrams  Int?
  recordedById  String
  notes         String?
  createdAt     DateTime @default(now())

  animalGroup AnimalGroup @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)
  recordedBy  User        @relation(fields: [recordedById], references: [id])

  @@index([animalGroupId, takenOn])
}

enum FlockCostCategory {
  STOCK_PURCHASE
  FEED
  HEALTH
  LABOUR
  UTILITIES
  TRANSPORT
  OTHER
}

/// Append-only cost ledger per group. Accumulates through the ~20-week rearing
/// period so that "cost per point-of-lay pullet reared" is a fact, not an estimate.
model FlockCostEntry {
  id            String            @id @default(cuid())
  animalGroupId String
  category      FlockCostCategory
  /// INTEGER PESEWAS. See src/lib/money.ts.
  amountPesewas Int
  incurredOn    DateTime          @db.Date
  description   String?
  sourceType    String?
  sourceId      String?

  /// Set when this entry is one flock's share of a cost that covered several.
  allocationId     String?
  /// The weight this flock carried in that split — bird-days, birds, or 1.
  ///
  /// STORED, not recomputed. Bird-days depend on the population ledger, and a
  /// mortality correction entered next month would change what the same
  /// calculation returns today. The money was divided on the numbers that were
  /// true when it was divided, and this is those numbers.
  allocationWeight Float?

  recordedById  String
  createdAt     DateTime          @default(now())

  animalGroup AnimalGroup     @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)
  recordedBy  User            @relation(fields: [recordedById], references: [id])
  allocation  CostAllocation? @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@index([animalGroupId, incurredOn])
  @@index([animalGroupId, category])
  @@index([allocationId])
}

/// How a shared cost was divided between flocks. Every method is documented,
/// with its formula, in src/lib/cost-allocation.ts.
enum CostAllocationMethod {
  BIRD_DAYS
  HEADCOUNT
  EQUAL
  MANUAL
}

/// One real-world cost — a month's wages, an electricity bill, a truck hire —
/// and how it was divided between flocks.
///
/// WHY THE DIVISION IS A RECORD AND NOT JUST ITS RESULT
///   Six months from now, "why does this flock carry GHS 260 of July's
///   electricity?" is a question somebody will ask, most likely while deciding
///   whether rearing paid. Keeping only the seven cost entries the split
///   produced makes that question unanswerable. Keeping the bill, the method
///   and each flock's weight makes it arithmetic anyone can check.
///
/// NOTHING HERE IS EVER EDITED OR DELETED. A correction is a reversal — a new
/// allocation carrying the negative of every entry — so the cost ledger keeps
/// both the mistake and the fix, in the order they happened.
model CostAllocation {
  id             String               @id @default(cuid())
  organisationId String
  category       FlockCostCategory
  /// INTEGER PESEWAS, the whole bill before it was divided. Negative on a reversal.
  amountPesewas  Int
  incurredOn     DateTime             @db.Date
  description    String
  method         CostAllocationMethod
  /// The window a BIRD_DAYS split covers. Null for the other methods.
  periodStart    DateTime?            @db.Date
  periodEnd      DateTime?            @db.Date
  /// Invoice or receipt number, so the paper and the record can be matched.
  reference      String?

  /// The allocation this one reverses.
  ///
  /// UNIQUE, so the database itself refuses to reverse the same cost twice —
  /// a rule that is far better held by a constraint than by a check somewhere
  /// in application code that a future route handler might forget to call.
  reversesId     String?              @unique

  recordedById   String
  createdAt      DateTime             @default(now())

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  recordedBy   User             @relation(fields: [recordedById], references: [id])
  reverses     CostAllocation?  @relation("CostAllocationReversal", fields: [reversesId], references: [id])
  reversedBy   CostAllocation?  @relation("CostAllocationReversal")
  entries      FlockCostEntry[]

  @@index([organisationId, incurredOn])
  @@index([organisationId, category])
}

// ---------------------------------------------------------------------------
// DAILY RECORD
// The single most-used screen in the system. Phase-aware: which child records
// are expected depends on the group's lifecycle stage.
// ---------------------------------------------------------------------------

model DailyRecord {
  id               String   @id @default(cuid())
  productionUnitId String
  animalGroupId    String
  onDate           DateTime @db.Date

  /// Client-generated. The defence against duplicate submissions when a phone
  /// retries over a bad connection. Unique — the second attempt is rejected,
  /// never merged.
  idempotencyKey   String   @unique

  /// Feed given to this house today, in kilograms.
  ///
  /// A plain number for now. At Milestone 6 issuing feed also writes a
  /// StockMovement against real inventory, and this column becomes a cache of
  /// that — the same pattern as `AnimalGroup.currentStageId`. It stays here
  /// because feed given is what the person in the house actually observes.
  feedKg           Float?
  waterLitres      Float?

  // --- Brooding ------------------------------------------------------------
  // Captured only while a flock is young enough to need heat. The daily record
  // asks for these when the flock is brooding and stops asking when it is not,
  // rather than showing a farmhand fields that will never apply again.

  /// House temperature at the birds, in °C.
  broodTempC       Float?

  /// What the chicks were doing — see CHICK_BEHAVIOURS in src/lib/rearing.ts.
  ///
  /// Recorded ALONGSIDE the temperature, not instead of it. Chicks are a better
  /// instrument than a thermometer on a wall: huddled under the heat means cold,
  /// pressed to the walls means hot, and either reading tells you more than a
  /// number taken three metres from where the birds actually are.
  chickBehaviour   String?

  /// dry · damp · wet · caked. Wet litter is where coccidiosis starts.
  litterCondition  String?

  observations     String?

  /// Plausibility warnings that were shown and accepted at entry time, e.g.
  /// [{ "field": "mortality", "message": "..." }].
  ///
  /// The system warns but never blocks — a farm that cannot record what actually
  /// happened stops being a record of anything. Keeping the accepted warnings
  /// makes it possible to review, later, which figures were unusual when entered
  /// rather than unusual in hindsight.
  warnings         Json?

  recordedById     String
  verifiedById     String?
  verifiedAt       DateTime?

  productionUnit ProductionUnit @relation(fields: [productionUnitId], references: [id])
  animalGroup    AnimalGroup    @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)
  recordedBy     User           @relation(fields: [recordedById], references: [id])
  verifiedBy     User?          @relation("DailyRecordVerifier", fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([animalGroupId, onDate])
  @@index([productionUnitId, onDate])
}

// ---------------------------------------------------------------------------
// PRODUCTION
//
// What comes out of a group — eggs, milk, weaned piglets, harvested fish.
//
// NOTHING HERE IS NAMED "EGG". A grade is a row the farm edits, not a value in
// an enum a developer chose, so "Large" and "Cracked" are configuration in
// exactly the way "Flock" and "House" are. The same three tables count litres of
// milk; only the grade rows change.
//
// A DAY IS SEVERAL COLLECTIONS, NOT ONE EDITABLE TOTAL. Eggs are gathered two or
// three times a day, by whoever walked the house. Each walk is its own row and
// the day's figure is their sum. A single total per day would mean the second
// collection overwrites the first — the one thing this architecture never allows.
// ---------------------------------------------------------------------------

/// A quality or size band the farm sorts its output into.
///
/// HUNG OFF THE PRODUCTION TYPE, not the organisation — the same choice as
/// LifecycleStage. A farm running layers and broilers grades eggs and grades
/// carcasses, and the two lists have nothing to do with each other.
///
/// THE WEIGHT BANDS ARE NOT SHIPPED. Egg size bands vary between buyers and
/// between countries, and a band baked into software would be trusted: eggs
/// would be sorted to a boundary nobody on the farm chose and no customer
/// agreed. They are seeded blank and the farm sets them, exactly like breed
/// weight curves.
model ProductionGrade {
  id                      String @id @default(cuid())
  productionTypeProfileId String

  /// Stable key used in imports and exports, e.g. "large", "cracked".
  key  String
  name String

  /// Whether the farm can sell it. Cracked, dirty and floor-laid eggs cannot.
  ///
  /// The flag the saleable rate is computed from, and — once orders exist — the
  /// flag that decides what may be put on an invoice at all.
  isSaleable Boolean @default(true)

  /// The farm's own grading boundary, in GRAMS. Null means nobody has set one,
  /// which is not the same as "no boundary applies".
  minGrams Int?
  maxGrams Int?

  /// The base unit this grade is counted in — `piece` for eggs, `litre` for
  /// milk. Held so the unit layer can refuse a cross-dimension entry rather than
  /// silently accepting kilograms of eggs.
  baseUomId String

  /// The stock item this grade is held as, once the farm chooses to hold it.
  ///
  /// NULL IS THE ORDINARY CASE AND IS NOT A GAP. A grade that is not held as
  /// stock is still recorded, still counted and still graded — it simply does
  /// not become something with a quantity on hand. Cracked and floor eggs
  /// usually never will be.
  ///
  /// UNIQUE, so two grades cannot point at the same item. They would each add
  /// their eggs to it, and the store would hold twice what the farm collected.
  itemId    String? @unique

  /// Fixed display order. Grades read in the same places every day, so a change
  /// in the shape of a collection is visible at a glance.
  sortOrder Int     @default(0)
  /// RETIRED, NEVER DELETED. Production lines point at grades; deleting one
  /// would either destroy history or leave rows nobody can name.
  isActive  Boolean @default(true)

  productionType ProductionTypeProfile @relation(fields: [productionTypeProfileId], references: [id], onDelete: Cascade)
  baseUom        UnitOfMeasure         @relation(fields: [baseUomId], references: [id])
  item           Item?                 @relation(fields: [itemId], references: [id])
  lines          ProductionLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productionTypeProfileId, key])
  @@index([productionTypeProfileId, sortOrder])
}

/// What happens to what was collected.
///
/// THE FOOD-SAFETY SWITCH. Only SALEABLE output may ever reach a customer, and
/// a flock inside a withdrawal period cannot be recorded as SALEABLE — see
/// `assertSaleAllowed` in src/lib/withdrawal-service.ts.
///
/// A SHORT LIST ON PURPOSE. Adding a value is a migration, which is the right
/// amount of friction for a vocabulary that decides what goes into food.
enum ProductionDisposition {
  /// Fit for sale. The default, and the only one that becomes saleable stock.
  SALEABLE
  /// Kept back — under a withdrawal period, or awaiting a decision.
  HELD
  /// Destroyed.
  DISCARDED
  /// Eaten on the farm, or given to staff.
  HOME_USE
}

/// ONE COLLECTION from one group. Append-only.
model ProductionRecord {
  id               String  @id @default(cuid())
  animalGroupId    String
  /// Where it was collected from. Nullable because a group need not be assigned
  /// to a unit — and a collection that really happened must still be recordable.
  productionUnitId String?

  onDate   DateTime @db.Date
  /// Which collection of that day this was: 1, 2, 3.
  sequence Int

  /// Age of the group on the day, stamped at write time — the same rule as
  /// HealthEvent, so a corrected date of hatch cannot rewrite what was recorded.
  ageDays  Int

  /// What was counted in the house, before anything was graded, in the base unit.
  ///
  /// Null when the farm grades as it collects and there is only one figure. When
  /// there are two they are BOTH kept: eggs break between the house and the
  /// grading bench, and the difference between the counts is a measurement of
  /// that, not a discrepancy to be resolved away.
  countedBase    Float?
  /// What was actually typed, and in which unit. "12 crates" stays legible as
  /// "12 crates" rather than becoming 360.
  countedEntered Float?
  countedUomId   String?

  disposition     ProductionDisposition @default(SALEABLE)
  /// Why it was not sold, when it was not.
  dispositionNote String?

  /// Client-generated, the defence against a phone retrying over a bad
  /// connection. Unique: the second attempt is rejected, never merged.
  idempotencyKey String @unique

  /// Plausibility warnings shown and accepted at entry, as on DailyRecord.
  warnings Json?
  notes    String?

  /// The record this one corrects, carrying the NEGATIVE of its lines.
  ///
  /// A miscounted collection is fixed the way everything else in this system is
  /// fixed — with a new row that reverses the old one, followed by a fresh
  /// record holding the right figures. Both stay visible, in the order they
  /// happened. UNIQUE, so the database itself refuses to correct the same
  /// collection twice.
  correctsId String? @unique

  recordedById String

  animalGroup    AnimalGroup       @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)
  productionUnit ProductionUnit?   @relation(fields: [productionUnitId], references: [id])
  countedUom     UnitOfMeasure?    @relation(fields: [countedUomId], references: [id])
  corrects       ProductionRecord? @relation("ProductionCorrection", fields: [correctsId], references: [id])
  correctedBy    ProductionRecord? @relation("ProductionCorrection")
  recordedBy     User              @relation(fields: [recordedById], references: [id])
  lines          ProductionLine[]

  createdAt DateTime @default(now())

  @@unique([animalGroupId, onDate, sequence])
  @@index([animalGroupId, onDate])
  @@index([productionUnitId, onDate])
}

/// One grade's share of one collection.
model ProductionLine {
  id                 String @id @default(cuid())
  productionRecordId String
  productionGradeId  String

  /// SIGNED quantity in the grade's base unit. Negative only on a correction,
  /// which carries the negative of every line it reverses.
  quantityBase    Float
  /// What was typed and in which unit, kept for audit and display.
  enteredQuantity Float
  enteredUomId    String

  record  ProductionRecord @relation(fields: [productionRecordId], references: [id], onDelete: Cascade)
  grade   ProductionGrade  @relation(fields: [productionGradeId], references: [id])
  enteredUom UnitOfMeasure @relation("ProductionLineUom", fields: [enteredUomId], references: [id])

  createdAt DateTime @default(now())

  @@unique([productionRecordId, productionGradeId])
  @@index([productionGradeId])
}

// ---------------------------------------------------------------------------
// UNITS OF MEASURE
// Prevents the classic disaster where "180" means bags to one person and
// kilograms to another.
// ---------------------------------------------------------------------------

enum UomDimension {
  COUNT
  MASS
  VOLUME
}

model UnitOfMeasure {
  id             String       @id @default(cuid())
  /// "piece", "crate", "kg", "bag_50kg", "litre".
  key            String       @unique
  name           String
  symbol         String
  dimension      UomDimension
  /// Multiply by this to reach the dimension's base unit
  /// (COUNT -> piece, MASS -> kg, VOLUME -> litre).
  /// crate = 30, bag_50kg = 50, tonne = 1000.
  factorToBase   Float
  isBase         Boolean      @default(false)

  items          Item[]
  stockMovements StockMovement[]
  productionGrades  ProductionGrade[]
  productionLines   ProductionLine[]   @relation("ProductionLineUom")
  productionRecords ProductionRecord[]
  purchaseOrderLines PurchaseOrderLine[] @relation("PurchaseOrderLineUom")

  @@index([dimension])
}

// ---------------------------------------------------------------------------
// INVENTORY — same ledger discipline as population
// ---------------------------------------------------------------------------

enum ItemCategory {
  FEED
  VACCINE
  MEDICINE
  DISINFECTANT
  PACKAGING
  FUEL
  PPE
  EQUIPMENT
  SPARE_PART
  FINISHED_PRODUCT
  OTHER
}

model Item {
  id             String       @id @default(cuid())
  organisationId String
  sku            String
  name           String
  category       ItemCategory
  /// The unit this item's stock is COUNTED in. Movements are stored converted
  /// to the dimension's base unit; this is the display/entry preference.
  stockUomId     String
  /// Advisory thresholds for the alert engine. Nullable = no alerting.
  reorderLevel   Float?
  minimumStock   Float?
  isPerishable   Boolean      @default(false)
  /// How many days after it is produced or received this item keeps.
  ///
  /// USED TO DATE A BATCH, never to refuse one. Null means nobody has stated a
  /// figure — and no default is shipped, because how long an egg keeps depends
  /// on whether it is washed, how it is stored and how hot the room is, none of
  /// which this software knows. A batch with no expiry date simply reports none.
  shelfLifeDays  Int?
  isActive       Boolean      @default(true)

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stockUom     UnitOfMeasure   @relation(fields: [stockUomId], references: [id])
  batches      ItemBatch[]
  movements    StockMovement[]
  programmeItems HealthProgrammeItem[]
  healthEvents   HealthEvent[]
  productionGrade ProductionGrade?
  cleaningRecords CleaningRecord[]
  purchaseOrderLines PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, sku])
  @@index([organisationId, category])
}

/// Batch/lot with expiry. Vaccines and medicines must never be issued expired.
model ItemBatch {
  id                String    @id @default(cuid())
  itemId            String
  batchNumber       String
  expiresOn         DateTime? @db.Date
  /// INTEGER PESEWAS per base unit, captured at receipt. This is what makes
  /// flock costing accurate rather than an average guess.
  unitCostPesewas   Int?
  receivedOn        DateTime  @db.Date

  item         Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  movements    StockMovement[]
  healthEvents HealthEvent[]

  createdAt DateTime @default(now())

  @@unique([itemId, batchNumber])
  @@index([expiresOn])
}

model StockLocation {
  id       String  @id @default(cuid())
  siteId   String
  name     String
  code     String
  isActive Boolean @default(true)

  /// Where this site's produce goes when it is recorded.
  ///
  /// A FLAG RATHER THAN A QUESTION ON THE COLLECTION FORM. Somebody walking a
  /// house with a tray in one hand should not be asked which building the eggs
  /// are going to; they are going where they always go. A site with no store
  /// flagged simply records the collection and puts nothing into stock, and the
  /// screen says so — setting up a store is never a precondition for writing
  /// down what was collected.
  receivesProduction Boolean @default(false)

  site      Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@unique([siteId, code])
}

enum StockMovementType {
  PURCHASE_RECEIPT
  ISSUE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DAMAGE
  EXPIRY
  SALE
  PRODUCTION
  CONSUMPTION
}

/// THE STOCK LEDGER. Append-only, exactly like the population ledger.
/// `quantityOnHand` is a query over this table, never a column.
model StockMovement {
  id              String            @id @default(cuid())
  itemId          String
  itemBatchId     String?
  stockLocationId String
  type            StockMovementType

  /// SIGNED quantity IN THE DIMENSION'S BASE UNIT (kg, piece, litre).
  /// Set exclusively by `recordStockMovement()`. Receipts positive, issues negative.
  deltaBase       Float
  /// What the user actually typed and in which unit, kept for audit and display:
  /// "4 bags" stays legible as "4 bags", not 200 kg.
  enteredQuantity Float
  enteredUomId    String

  occurredOn      DateTime @db.Date
  reasonCode      String?
  notes           String?
  sourceType      String?
  sourceId        String?

  recordedById    String
  createdAt       DateTime @default(now())

  item          Item          @relation(fields: [itemId], references: [id])
  itemBatch     ItemBatch?    @relation(fields: [itemBatchId], references: [id])
  stockLocation StockLocation @relation(fields: [stockLocationId], references: [id])
  enteredUom    UnitOfMeasure @relation(fields: [enteredUomId], references: [id])
  recordedBy    User          @relation(fields: [recordedById], references: [id])

  @@index([itemId, occurredOn])
  @@index([stockLocationId, itemId])
  @@index([itemBatchId])
  /// What a movement came FROM: a daily record, a production record, a purchase
  /// order line. Indexed because "how much of this order has actually arrived?"
  /// is a query over exactly this pair, run on every order screen.
  @@index([sourceType, sourceId])
}

/// A breed, and the growth curve its breeder publishes for it.
///
/// WHY THE STANDARD LIVES HERE AND NOT ON THE PRODUCTION TYPE
///   It used to hang off `ProductionTypeProfile` — "layer" — which is wrong the
///   moment a farm runs two breeds or changes supplier. An ISA Brown and a
///   Lohmann Brown are both layers and do not weigh the same at eight weeks, so
///   scoring a flock against a shared "layer" curve would report a perfectly
///   healthy flock as behind target.
///
/// The BREED NAMES are seeded as a convenience catalogue. The WEIGHT FIGURES
/// are not: they come from the breeder's own management guide, loaded with
/// `npm run standards:load`, and a breed with none reports no comparison rather
/// than being scored against a guess.
model Breed {
  id                      String  @id @default(cuid())
  organisationId          String
  speciesProfileId        String?
  productionTypeProfileId String?

  /// Stable key, e.g. "isa_brown".
  key      String
  name     String
  /// The breeding company, e.g. "ISA / Hendrix Genetics".
  supplier String?

  /// Breeder-published figures, keyed the same way the loader writes them:
  ///   { "bodyWeightByAgeDays": { "7": 70, ... },
  ///     "bodyWeightSource": "standards/isa-brown.csv",
  ///     "bodyWeightLoadedAt": "2026-08-26T…" }
  standards Json?

  isActive Boolean @default(true)

  organisation   Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  speciesProfile SpeciesProfile?        @relation(fields: [speciesProfileId], references: [id])
  productionType ProductionTypeProfile? @relation(fields: [productionTypeProfileId], references: [id])
  animalGroups   AnimalGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, key])
  @@index([organisationId, isActive])
}

// ---------------------------------------------------------------------------
// HEALTH
//
// THE GOVERNING RULE OF THIS SECTION: THE SYSTEM HOLDS NO MEDICAL OPINION.
//
// There is no built-in vaccination schedule, no default withdrawal period and
// no suggested dose anywhere in this codebase. Every figure below arrives as
// DATA, entered or imported by the farm from a programme its veterinarian
// supplied, and every programme records who supplied it and when.
//
// This is not caution for its own sake. A shipped default would be trusted: a
// farmhand would give a vaccine on day 14 because the screen said day 14, and
// nobody could later say which vet stood behind that number, for which breed,
// under which disease pressure. Ghana's Newcastle challenge is not Europe's.
// Getting this wrong kills flocks.
//
// What the system DOES do is arithmetic: given a programme and a date of hatch,
// it works out dates, notices what is due, and refuses to let a withdrawal
// period be forgotten. That is bookkeeping, and bookkeeping is what software
// should be trusted with.
// ---------------------------------------------------------------------------

/// Whether a programme has been signed off by a named person qualified to do so.
///
/// The reason this exists: a farm needs to start recording the day the hatchery
/// hands over a schedule, which is long before a veterinarian has looked at it.
/// Blocking entry until then means the first weeks go unrecorded — the weeks
/// that matter most. So a programme can be used while still DRAFT, and every
/// screen that shows it says plainly that nobody has reviewed it.
enum HealthProgrammeStatus {
  DRAFT
  APPROVED
}

enum HealthEventType {
  VACCINATION
  MEDICATION
  SUPPLEMENT
  TREATMENT
  VET_VISIT
  DIAGNOSIS
  POST_MORTEM
  OTHER
}

/// How something was given. Route matters clinically — the same vaccine by eye
/// drop and in drinking water are not interchangeable — so it is recorded
/// rather than left in a note.
enum AdministrationRoute {
  DRINKING_WATER
  EYE_DROP
  NASAL_DROP
  SPRAY
  WING_WEB
  INJECTION_SUBCUTANEOUS
  INJECTION_INTRAMUSCULAR
  IN_FEED
  TOPICAL
  ORAL
  OTHER
}

/// A health programme: a list of planned interventions keyed to AGE, not dates.
///
/// Keyed to age because a flock delivered a week late is still the age it
/// hatched, and every schedule in poultry is written against age in days.
model HealthProgramme {
  id                      String  @id @default(cuid())
  organisationId          String
  /// Optional narrowing, so a farm running more than one species or type can
  /// keep their programmes apart. Null means "applies to anything".
  speciesProfileId        String?
  productionTypeProfileId String?

  name        String
  description String?

  // --- Provenance ---------------------------------------------------------
  // Required by the brief and by common sense: every scheduled intervention
  // must trace back to a named human who stood behind it.

  /// The veterinarian, hatchery or supplier this programme came from.
  sourceName  String?
  /// Their role or practice, e.g. "Veterinary Officer, Ashanti".
  sourceRole  String?
  /// When they supplied or last reviewed it. A programme nobody has looked at
  /// in three years is a fact the farm should be able to see.
  reviewedOn  DateTime? @db.Date

  // --- Approval -----------------------------------------------------------
  //
  // Separate from `source`, because the two are genuinely different claims:
  // "this came from the hatchery" and "a veterinarian has checked it for this
  // farm" are not the same, and only the second is oversight.
  //
  // EDITING AN APPROVED PROGRAMME RETURNS IT TO DRAFT. Without that rule,
  // someone approves a safe schedule and then edits it into an unsafe one under
  // the approver's name. Enforced in the service, not left to the caller.
  status          HealthProgrammeStatus @default(DRAFT)
  /// The veterinarian who signed it off. Free text: most vets attending a
  /// Ghanaian farm have no account here, and demanding one would mean the
  /// approval simply never gets recorded.
  approvedByName  String?
  approvedByRole  String?
  approvedOn      DateTime?             @db.Date

  isActive Boolean @default(true)

  organisation   Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  speciesProfile SpeciesProfile?        @relation(fields: [speciesProfileId], references: [id])
  productionType ProductionTypeProfile? @relation(fields: [productionTypeProfileId], references: [id])

  items       HealthProgrammeItem[]
  animalGroups AnimalGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, name])
  @@index([organisationId, isActive])
}

/// One planned intervention within a programme.
model HealthProgrammeItem {
  id                String @id @default(cuid())
  healthProgrammeId String

  /// Age in DAYS at which this is planned. The whole schedule hangs off this.
  ageDays    Int
  /// How many days either side still counts as "on time". Entered by the farm;
  /// there is no default that means anything clinically, so the column default
  /// is only a starting point for the form.
  windowDays Int    @default(2)

  /// What it is, in the farm's own words: "Newcastle — La Sota", "Gumboro".
  name      String
  eventType HealthEventType     @default(VACCINATION)
  route     AdministrationRoute?

  /// Optional link to the store, so giving it draws real stock and costs the
  /// flock. Null for anything the farm does not hold as inventory.
  itemId      String?
  /// Quantity per bird, in the item's BASE unit (doses, ml, grams).
  dosePerBird Float?

  /// Withdrawal periods, in days, AS STATED ON THE PRODUCT LABEL.
  /// Null means none was recorded — which is not the same as none applying.
  eggWithdrawalDays  Int?
  meatWithdrawalDays Int?

  notes     String?
  /// Two interventions can fall on the same day; this keeps their order stable.
  sortOrder Int     @default(0)

  programme HealthProgramme @relation(fields: [healthProgrammeId], references: [id], onDelete: Cascade)
  item      Item?           @relation(fields: [itemId], references: [id])
  events    HealthEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([healthProgrammeId, ageDays])
}

/// Something that was actually done to a flock.
///
/// DELIBERATELY NOT AN AnimalGroupEvent. That ledger exists to answer "how many
/// birds are there", and every row in it moves the count. A vaccination moves no
/// birds. Mixing the two would mean every population sum had to know which event
/// types to ignore — and the day someone forgets, the flock count is wrong.
/// Deaths following a reaction are recorded on the population ledger as
/// mortality, in the ordinary way, and the two are linked by date.
model HealthEvent {
  id              String  @id @default(cuid())
  animalGroupId   String
  /// Which planned item this fulfils, when it fulfils one. Null for anything
  /// unplanned — an outbreak, a vet visit, a treatment nobody scheduled.
  programmeItemId String?

  type       HealthEventType
  name       String
  occurredOn DateTime            @db.Date
  /// Age of the flock on the day, stamped at write time so the record still
  /// reads correctly if a hatch date is ever corrected.
  ageDays    Int
  route      AdministrationRoute?

  /// How many birds this covered. Null when it does not apply (a vet visit).
  birdsTreated Int?

  // --- What it consumed ---------------------------------------------------
  itemId       String?
  itemBatchId  String?
  /// Quantity used, in the item's base unit. Written by the health service, which
  /// issues the same quantity from the store in one transaction.
  quantityBase Float?
  /// INTEGER PESEWAS, snapshotted at the time. See src/lib/money.ts.
  costPesewas  Int?

  // --- Withdrawal ---------------------------------------------------------
  // Copied ONTO THE EVENT rather than read back off the programme, because the
  // product actually used may differ from the one planned, and a withdrawal
  // period that changes retroactively is a food-safety failure.
  eggWithdrawalDays  Int?
  meatWithdrawalDays Int?

  // --- Who ----------------------------------------------------------------
  /// The person who physically gave it. Free text: many farmhands and visiting
  /// vets have no account, and forcing one would mean the name goes unrecorded.
  administeredBy String?
  /// The veterinarian who attended or authorised it.
  vetName        String?
  diagnosis      String?
  notes          String?

  recordedById String

  animalGroup   AnimalGroup          @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)
  programmeItem HealthProgrammeItem? @relation(fields: [programmeItemId], references: [id])
  item          Item?                @relation(fields: [itemId], references: [id])
  itemBatch     ItemBatch?           @relation(fields: [itemBatchId], references: [id])
  recordedBy    User                 @relation(fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([animalGroupId, occurredOn])
  @@index([programmeItemId])
  @@index([animalGroupId, type])
}

// ---------------------------------------------------------------------------
// IDENTITY & ACCESS
// Permissions are `resource:action` strings. Roles bundle them. Access is
// additionally scoped to sites. Enforcement lives in ONE server-side gate.
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  organisationId String
  /// Office and customer users sign in with email.
  email          String?   @unique
  /// Farm staff sign in with phone + PIN — many farmhands have no email address.
  /// E.164, e.g. +233241234567. Wired up at Milestone 12, when staff exist.
  phone          String?   @unique
  name           String
  passwordHash   String?
  pinHash        String?
  isActive       Boolean   @default(true)
  /// Forces a password change on next sign-in. Set on seeded and admin-created
  /// accounts so a default credential can never quietly become permanent.
  mustChangePassword Boolean @default(false)
  lastLoginAt    DateTime?

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  roles        UserRole[]
  siteScopes   UserSiteScope[]

  animalGroupEvents  AnimalGroupEvent[]
  weightSamples      WeightSample[]
  flockCostEntries   FlockCostEntry[]
  stockMovements     StockMovement[]
  dailyRecords       DailyRecord[]
  verifiedRecords    DailyRecord[]      @relation("DailyRecordVerifier")
  healthEvents       HealthEvent[]
  costAllocations    CostAllocation[]
  visitorLogs        VisitorLog[]
  cleaningRecords    CleaningRecord[]
  biosecurityChecks  BiosecurityCheck[]
  productionRecords  ProductionRecord[]
  auditLogs          AuditLog[]
  ordersPlaced       PurchaseOrder[]    @relation("PurchaseOrderPlacedBy")
  ordersSent         PurchaseOrder[]    @relation("PurchaseOrderSentBy")
  ordersCancelled    PurchaseOrder[]    @relation("PurchaseOrderCancelledBy")
  attendance         AttendanceEvent[]  @relation("AttendanceSubject")
  attendanceRecorded AttendanceEvent[]  @relation("AttendanceRecorder")
  tasksAssigned      Task[]             @relation("TaskAssignee")
  tasksCompleted     Task[]             @relation("TaskCompletedBy")
  tasksCreated       Task[]             @relation("TaskCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
}

model Role {
  id          String  @id @default(cuid())
  /// "owner", "manager", "supervisor", "worker", "storekeeper", "sales", "customer".
  key         String  @unique
  name        String
  description String?
  /// System roles cannot be deleted, only extended.
  isSystem    Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String  @id @default(cuid())
  /// "flock:create", "finance:view", "inventory:adjust".
  key         String  @unique
  resource    String
  action      String
  description String?

  roles RolePermission[]

  @@index([resource])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

/// Absence of rows = access to every site (the owner). Presence of rows =
/// access restricted to exactly those sites.
model UserSiteScope {
  userId String
  siteId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
}

/// Sign-in attempts, successful and failed.
///
/// Backs rate limiting: too many failures against one email, or from one IP,
/// locks further attempts for a cooling-off period. Kept in the database rather
/// than in process memory deliberately — an in-memory counter resets on every
/// deploy and is per-instance, which on serverless means effectively no limit
/// at all.
model LoginAttempt {
  id         String   @id @default(cuid())
  /// Lowercased email, phone, or IP address — whatever is being limited.
  identifier String
  successful Boolean
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// AUDIT
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organisationId String
  actorId        String?
  /// "price.change", "stock.adjust", "population.adjust", "permission.change".
  action         String
  entityType     String
  entityId       String
  /// Only the fields that changed, not the whole row.
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organisationId, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// BIOSECURITY
// Milestone 10. Who came in, what was cleaned, what an inspection found.
// ---------------------------------------------------------------------------

/// Why someone came. A controlled list so a year of visits can be counted by
/// kind — "how often was a feed lorry on the site" is a question worth being
/// able to answer, and free text never answers it.
enum VisitorKind {
  VETERINARIAN
  SUPPLIER
  BUYER
  CONTRACTOR
  INSPECTOR
  /// Farm staff returning from elsewhere. They are visitors for this purpose.
  STAFF_RETURNING
  NEIGHBOUR
  OTHER
}

/// What a visitor said about their last contact with other poultry.
///
/// THREE STATES, NOT A NULLABLE DATE. "No date" would have to stand for both
/// "they have not been near poultry" and "nobody asked them" — two answers that
/// mean opposite things. See ContactDeclaration in src/lib/biosecurity.ts.
enum PoultryContactDeclaration {
  /// Nobody asked, or they did not answer.
  NOT_DECLARED
  /// They said they have not been near other poultry.
  NONE
  /// They gave a date and time; see lastPoultryContactAt.
  AT
}

/// Every person who came onto a site, and what they declared on the way in.
///
/// A RECORD OF DECLARATIONS, NOT OF FACTS. Everything a visitor says about
/// where they have been is written down as having been said, not as having been
/// verified — the software cannot know, and a record that pretends otherwise is
/// worse than one that admits it.
///
/// Append-only in practice: a visit is never edited to change what was
/// declared. Only `departedAt` is written afterwards, because signing out
/// genuinely happens later than signing in.
model VisitorLog {
  id     String @id @default(cuid())
  siteId String

  name         String
  organisation String?
  /// E.164, e.g. +233241234567.
  phone        String?
  kind         VisitorKind
  purpose      String?

  arrivedAt  DateTime
  departedAt DateTime?

  declaration          PoultryContactDeclaration @default(NOT_DECLARED)
  /// Set only when `declaration` is AT.
  lastPoultryContactAt DateTime?

  /// The rule in force AT THE TIME, stamped onto the row.
  ///
  /// Copied rather than read back from the site, for the same reason a health
  /// event carries its own withdrawal period: changing the farm's downtime rule
  /// next year must not silently rewrite what last year's visits are reported
  /// to have complied with.
  downtimeHoursAtEntry Int?

  vehicleRegistration String?
  /// Whether they went into a house where birds are, as opposed to the yard.
  enteredProductionUnit Boolean @default(false)
  /// Measures actually taken. Null means nobody recorded either way.
  usedFootbath          Boolean?
  woreFarmClothing      Boolean?

  notes        String?
  recordedById String

  site       Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  recordedBy User @relation(fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([siteId, arrivedAt])
  @@index([siteId, departedAt])
}

/// What was cleaned. A house, a store, a vehicle, a stretch of yard.
enum CleaningScope {
  PRODUCTION_UNIT
  STORE
  EQUIPMENT
  VEHICLE
  /// A footbath, the perimeter, the gate — somewhere on the site with no row
  /// of its own. Named in `areaName`.
  SITE_AREA
}

/// Which part of the job this record covers.
///
/// SEPARATE ROWS, NOT TICK-BOXES ON ONE. Muck-out, wash, disinfect and rest
/// happen on different days, often by different people, and a single row with
/// four checkboxes cannot say when each was done. Between flocks the sequence
/// IS the procedure, and its dates are what a vet or a buyer will ask about.
enum CleaningStage {
  DRY_CLEAN
  WASH
  DISINFECT
  FUMIGATE
  /// The empty period before the next flock goes in.
  REST
  /// One record covering the whole turnaround, for a farm that works that way.
  FULL_TURNAROUND
}

/// Cleaning and disinfection, as carried out.
///
/// Append-only. A clean that was recorded happened; a clean recorded wrongly is
/// corrected by recording the right one, not by editing the wrong one away.
model CleaningRecord {
  id               String        @id @default(cuid())
  siteId           String
  scope            CleaningScope
  /// Set when the scope is PRODUCTION_UNIT.
  productionUnitId String?
  /// Free text for anything without a row of its own — "footbath at the gate".
  areaName         String?

  stage       CleaningStage
  performedOn DateTime      @db.Date
  /// Who did the work. FREE TEXT, because it is often a casual hand with no
  /// account here, and a record that can only name system users would quietly
  /// stop naming anybody.
  performedBy String?

  /// The product used, when it came out of the store.
  itemId       String?
  /// How much, in the item's base unit. Null when nothing was drawn from stock.
  quantityBase Float?
  /// As written on the container — "1:200", "20 ml per litre".
  ///
  /// FREE TEXT ON PURPOSE. Every disinfectant states its rate differently, and
  /// a structured field would force whoever is holding the bottle to translate
  /// it — which is exactly where a dilution error comes from.
  dilution     String?
  /// Minutes the surface was left wet, where the label asks for it.
  contactTimeMinutes Int?

  notes        String?
  recordedById String

  site           Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  productionUnit ProductionUnit? @relation(fields: [productionUnitId], references: [id])
  item           Item?           @relation(fields: [itemId], references: [id])
  recordedBy     User            @relation(fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([siteId, performedOn])
  @@index([productionUnitId, performedOn])
}

/// A checklist the farm inspects against.
///
/// NO CHECKLIST CONTENT IS SHIPPED AS A STANDARD. What matters on a particular
/// farm depends on its layout, its neighbours and whoever buys from it, and a
/// list baked into software would be read as an authority it has not earned.
/// The screens offer a set of common starting points, clearly labelled as a
/// starting point rather than a standard, and every line is editable.
model BiosecurityChecklist {
  id             String  @id @default(cuid())
  organisationId String
  name           String
  description    String?
  /// RETIRED, NEVER DELETED. Inspections point at it.
  isActive       Boolean @default(true)

  organisation Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  items        BiosecurityChecklistItem[]
  checks       BiosecurityCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, name])
}

model BiosecurityChecklistItem {
  id          String  @id @default(cuid())
  checklistId String
  /// Stable key, derived from the label. Survives a rewording.
  key         String
  label       String
  /// What to actually look at. Optional, and worth filling in — the person
  /// holding the phone at six in the morning is not always the person who
  /// wrote the list.
  guidance    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  checklist BiosecurityChecklist   @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  lines     BiosecurityCheckLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([checklistId, key])
  @@index([checklistId, sortOrder])
}

enum CheckResult {
  PASS
  FAIL
  /// Looked at nothing. Counted and reported, never folded into a pass.
  NOT_CHECKED
  NOT_APPLICABLE
}

/// One inspection: a checklist, walked on a day, with an answer per line.
model BiosecurityCheck {
  id          String   @id @default(cuid())
  siteId      String
  checklistId String
  performedOn DateTime @db.Date
  /// Free text — an inspector, a buyer's auditor or a farmhand.
  performedBy String?
  notes       String?
  recordedById String

  site       Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  checklist  BiosecurityChecklist @relation(fields: [checklistId], references: [id])
  recordedBy User                 @relation(fields: [recordedById], references: [id])
  lines      BiosecurityCheckLine[]

  createdAt DateTime @default(now())

  @@index([siteId, performedOn])
}

model BiosecurityCheckLine {
  id              String      @id @default(cuid())
  checkId         String
  checklistItemId String
  result          CheckResult
  note            String?

  /// The wording of the line AS IT STOOD when the inspection was carried out.
  ///
  /// COPIED, NOT JOINED. Rename "No rodent activity" to "Rodent control in
  /// place" next year and every past inspection would otherwise be reported as
  /// having answered a question nobody was asked. What an inspection recorded
  /// is what was on the page that morning.
  labelAtCheck    String

  check BiosecurityCheck         @relation(fields: [checkId], references: [id], onDelete: Cascade)
  item  BiosecurityChecklistItem @relation(fields: [checklistItemId], references: [id])

  createdAt DateTime @default(now())

  @@unique([checkId, checklistItemId])
  @@index([checklistItemId, result])
}

// ---------------------------------------------------------------------------
// PROCUREMENT
// Milestone 11. Who the farm buys from, what was ordered, what turned up.
// ---------------------------------------------------------------------------

/// Somebody the farm buys from.
///
/// ARCHIVED, NEVER DELETED. Orders point at a supplier, and a year of feed
/// deliveries has to stay readable after the farm stops using that mill.
model Supplier {
  id             String  @id @default(cuid())
  organisationId String
  name           String
  /// Short reference used on paperwork. Derived from the name when left blank.
  code           String

  contactName String?
  /// Kept EXACTLY AS TYPED. Ghanaian numbers arrive in five different shapes
  /// and all of them are correct; src/lib/ghana.ts works out a dialable form
  /// when it can and leaves the original alone when it cannot.
  phone       String?
  /// A second number, because one line being off is normal.
  altPhone    String?
  email       String?

  town     String?
  district String?
  region   String?

  /// What this supplier actually sells, so the order screen can offer the right
  /// items first. Empty means nobody has said, not that they sell nothing.
  supplies ItemCategory[]

  /// How long THIS supplier takes, in days.
  ///
  /// Overrides the organisation's average when it is set. A mill two weeks away
  /// and a shop that delivers next morning should not share one figure — and
  /// the farm-wide default exists precisely because most suppliers have never
  /// been timed. Null means "use the farm's figure".
  leadTimeDays Int?

  /// As agreed, in words. "Cash on delivery", "30 days", "half up front".
  /// FREE TEXT: every supplier states terms differently and a structured field
  /// would force whoever took the call to translate them.
  paymentTerms String?

  notes    String?
  isActive Boolean @default(true)

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, code])
  @@index([organisationId, isActive])
}

// ---------------------------------------------------------------------------
// PURCHASE ORDERS
// ---------------------------------------------------------------------------

/// What somebody DID to an order.
///
/// Deliberately does NOT include "received" or "part received". Those are not
/// acts; they are what the receipts add up to, and a status column that carries
/// them is a status column that eventually disagrees with the rows beneath it.
/// See `fulfilmentOf` in src/lib/purchasing.ts.
enum PurchaseOrderState {
  DRAFT
  SENT
  CANCELLED
}

/// An order placed with a supplier.
///
/// AN ORDER IS AN EXPECTATION, NOT A FACT. It is kept exactly as it was placed
/// — including the price agreed and the date promised — so that when the lorry
/// brings twenty-one bags at a different price, the gap between what was agreed
/// and what happened is REPORTABLE rather than quietly overwritten.
///
/// Orders are CANCELLED, never deleted. "We ordered feed and cancelled it" is a
/// fact about the farm's week; a row that vanishes takes the reason with it.
model PurchaseOrder {
  id             String             @id @default(cuid())
  organisationId String
  /// Where the goods are going. Orders are site-scoped like everything else, so
  /// a supervisor at one farm cannot read another farm's ordering.
  siteId         String
  supplierId     String
  /// Human reference quoted on the phone and on paperwork. PO-2026-0007.
  orderNumber    String
  state          PurchaseOrderState @default(DRAFT)

  orderedOn  DateTime  @db.Date
  /// The date agreed with the supplier — NOT the farm's average lead time.
  ///
  /// Lateness is measured against this and nothing else. Measured against an
  /// average, every order from a slow supplier is permanently late and every
  /// order from a fast one permanently early, which tells nobody anything.
  /// Nullable, because plenty of orders are placed with no date promised.
  expectedOn DateTime? @db.Date

  /// When it actually went to the supplier, and who sent it. Stamped rather
  /// than inferred from `state`, so "sent last Tuesday" survives a later edit.
  sentAt   DateTime?
  sentById String?

  cancelledAt     DateTime?
  cancelledById   String?
  /// Why. Required by the action, because a cancellation with no reason is the
  /// one record everybody argues about three months later.
  cancelReason    String?

  notes       String?
  placedById  String

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  site         Site                @relation(fields: [siteId], references: [id])
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  placedBy     User                @relation("PurchaseOrderPlacedBy", fields: [placedById], references: [id])
  sentBy       User?               @relation("PurchaseOrderSentBy", fields: [sentById], references: [id])
  cancelledBy  User?               @relation("PurchaseOrderCancelledBy", fields: [cancelledById], references: [id])
  lines        PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, orderNumber])
  @@index([organisationId, state])
  @@index([siteId, orderedOn])
  @@index([supplierId])
}

/// One item on an order.
model PurchaseOrderLine {
  id              String @id @default(cuid())
  purchaseOrderId String
  itemId          String

  /// How many, IN THE UNIT IT WAS ORDERED IN — bags, not kilograms.
  quantityOrdered Float
  /// That unit. A farm orders bags and is invoiced per bag; converting to the
  /// base unit before storing means every screen has to convert back, and one
  /// of them eventually will not. `orderUom.factorToBase` does the conversion
  /// when receipts are matched against this line.
  orderUomId      String

  /// Agreed price per ORDERED unit, in integer pesewas.
  ///
  /// NULLABLE. Plenty of deliveries on a small farm are arranged by phone with
  /// the price settled on arrival, and a required price would force whoever
  /// took the call to invent one. No price means no variance is reported —
  /// rather than a variance reported against a guess.
  unitPricePesewas Int?

  notes String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])
  orderUom      UnitOfMeasure @relation("PurchaseOrderLineUom", fields: [orderUomId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One line per item. Two lines for one item make every "what is still
  /// outstanding" figure ambiguous, and the receiving screen would not know
  /// which of them to draw down.
  @@unique([purchaseOrderId, itemId])
  @@index([itemId])
}

// ---------------------------------------------------------------------------
// ATTENDANCE
// ---------------------------------------------------------------------------

enum AttendanceEventType {
  CLOCK_IN
  CLOCK_OUT
}

/// Who was on the farm, and when.
///
/// AN APPEND-ONLY LEDGER, exactly like population and stock. There is no
/// `isClockedIn` column and no Shift table: a shift is a CLOCK_IN and the
/// CLOCK_OUT that follows it, worked out on read by `pairShifts`. A stored
/// boolean and a ledger eventually disagree, and the boolean is always the one
/// that is wrong.
///
/// THERE IS NO LATITUDE OR LONGITUDE HERE, and that is a decision rather than an
/// omission. Clock-in is the obvious place to reach for GPS; the brief was
/// explicit that geofencing is discussed before it is built, and a nullable
/// "for later" column is how that discussion gets skipped.
///
/// NOTHING IN THIS TABLE IS ABOUT PAY. Hours are elapsed, never payable.
model AttendanceEvent {
  id             String              @id @default(cuid())
  organisationId String
  /// Whose attendance this is — not necessarily who recorded it.
  userId         String
  /// Which farm they turned up at.
  siteId         String
  type           AttendanceEventType

  /// The instant it happened. A timestamp, not a date, because a night shift
  /// crosses midnight and the two ends belong to different calendar days.
  occurredAt DateTime

  /// The farm-local day the SHIFT belongs to, stamped at write time.
  ///
  /// A watchman coming on at seven in the evening and leaving at six belongs to
  /// the night he started, not to two half-days either side of midnight. Stamped
  /// rather than derived on read so that "the week of the 6th" means the same
  /// thing in every query. See shiftDayOf() in src/lib/attendance.ts.
  shiftDay DateTime @db.Date

  notes String?

  /// Who actually pressed the button.
  ///
  /// Equal to `userId` for an ordinary clock-in. DIFFERENT when a supervisor
  /// closed a shift somebody forgot to close, which is the common case and must
  /// be visible as such — an entry made on somebody's behalf is a different kind
  /// of fact from one they made themselves, and a record that cannot tell them
  /// apart is a record nobody can dispute.
  recordedById String
  /// Why somebody else recorded it. Required by the service in that case.
  correctionReason String?

  createdAt DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation("AttendanceSubject", fields: [userId], references: [id])
  recordedBy   User         @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])

  @@index([organisationId, shiftDay])
  @@index([userId, occurredAt])
  @@index([siteId, shiftDay])
}

// ---------------------------------------------------------------------------
// TASKS
// ---------------------------------------------------------------------------

enum TaskPriority {
  NORMAL
  URGENT
}

/// A job somebody needs to do.
///
/// COMPLETION IS STORED, NOT DERIVED — the one place in this system where a
/// state sits on the row rather than being summed from a ledger, and worth
/// saying why. Population and stock ACCUMULATE, so a stored total is a second
/// source of truth waiting to disagree with the events beneath it. A task is
/// finished once; `completedAt` is the event, not a running total of them.
/// Everything that CAN be worked out still is: `overdue` is computed on read and
/// appears nowhere in this table.
///
/// TASKS ARE CANCELLED, NEVER DELETED. "We were going to move the pullets and
/// then didn't" is a fact about the week, and a row that vanishes takes the
/// reason with it.
///
/// NO RECURRENCE FIELD. The recurring-inspection case is answered by
/// BiosecurityChecklist; a second repeat engine beside it produces a task list
/// nobody reads. NO PHOTO EVIDENCE either — that means file storage, and the
/// provider is not a decision to make quietly.
model Task {
  id             String       @id @default(cuid())
  organisationId String
  siteId         String
  title          String
  detail         String?
  priority       TaskPriority @default(NORMAL)

  /// NULL MEANS ANYONE WHO IS FREE, which on a farm of three is the common case
  /// and a real answer rather than a missing one. Forcing an assignee produces a
  /// list where everything is nominally one person's.
  assigneeId String?

  /// Null means "when you can". A task with no date is never overdue — see
  /// isOverdue() in src/lib/tasks.ts.
  dueOn DateTime? @db.Date

  completedAt    DateTime?
  completedById  String?
  completionNote String?

  cancelledAt  DateTime?
  cancelReason String?

  createdById String

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id])
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  completedBy  User?        @relation("TaskCompletedBy", fields: [completedById], references: [id])
  createdBy    User         @relation("TaskCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, completedAt])
  @@index([siteId, dueOn])
  @@index([assigneeId, completedAt])
}
