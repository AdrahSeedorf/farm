# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma generated client (build artifact, regenerated by npm install)
src/generated/

# Environment
.env
.env.local
.env*.local
.e2e-fixture.mts

# Delivered task archives, and the folder they are parked in.
#
# This session cannot delete files inside a connected folder, so each task
# tarball is moved here after it is extracted rather than removed. They are
# build artefacts, not source: they belong on disk until somebody clears them
# out, and never in the repository.
_to_delete/
*.tgz
